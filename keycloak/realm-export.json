{
  "realm": "secure-mcp",
  "enabled": true,
  "accessTokenLifespan": 15,
  "ssoSessionIdleTimeout": 1800,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "catalyst-proxy",
      "name": "Diagrid MCP proxy (Diagrid's own service identity)",
      "enabled": true,
      "secret": "catalyst-proxy-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "secure-mcp-demo-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://secure-mcp-demo/",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
